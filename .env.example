APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=json

# Host-side connection used when running the API with `go run`.
# Docker Compose overrides this with the internal postgres hostname.
DATABASE_URL=postgres://postgres:postgres@localhost:5434/go_commerce?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=go_commerce

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=go-commerce:

JWT_SECRET=dev-only-secret-change-me-32-characters-minimum
JWT_ISSUER=go-commerce
JWT_AUDIENCE=go-commerce-api
JWT_TTL=24h

CART_TTL=168h
IDEMPOTENCY_TTL=168h
WORKER_COUNT=4
WORKER_QUEUE_SIZE=256
SHUTDOWN_TIMEOUT=15s
AUTO_MIGRATE=true

BCRYPT_COST=12
CURRENCY=USD
MAX_CART_ITEMS=50
MAX_ITEM_QUANTITY=99

# Used by `go run ./cmd/seed` only.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
